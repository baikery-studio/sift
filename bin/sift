#!/usr/bin/env bash
# bin/sift — fail-soft dispatch shim + pipeline router (spine).
# Fail-soft: an unknown subcommand or a missing dependency logs to stderr and
# exits 0 with empty stdout (never JSON) — a broken install is a no-op.
SIFT_BIN="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# PLUGIN root = where bin/kernel/profiles live (the installed plugin).
# REPO  root = the working repo where packets/state/artifacts live (cwd).
export SIFT_PLUGIN_ROOT="$(cd "$SIFT_BIN/.." && pwd)"
export SIFT_REPO_ROOT="${SIFT_REPO_ROOT:-${CLAUDE_PROJECT_DIR:-$(pwd)}}"

cmd="${1:-}"; [ "$#" -gt 0 ] && shift
_sift_usage() {
  echo "usage: sift <verb> [args]   (the build-rigor harness; 'done' is witness-proven)"
  echo "  plan|execute|review <id>   drive a packet plan -> execute -> review -> confirmed"
  echo "  state <id>                 the packet's replayed state (confirmed/.../corrupt/unknown)"
  echo "  status | next <wave>       operator board / next actionable packet in a wave"
  echo "  drive <wave>               autonomous loop a wave to ALL-CONFIRMED (if available)"
  echo "  packet new <id> [--profile P] | validate <id>"
  echo "  setup | init-claudemd      bootstrap a repo / make the loop a standing rule"
  echo "  verify-log | migrate-log   tamper-evidence check / re-chain an old-schema log"
  echo "  audit <id> | export <id>   second-party replay-verify / portable bundle (if available)"
  echo "  w3-verdict <id> <staging>  land an agent-authored host W3 verdict past the scope fence"
  echo "  doctor | coverage <wave>   re-verify confirmeds / advisory wave gap-finding"
  echo "  abort <id> | supersede <id>   in-band recovery / retire a packet"
  echo "  selftest | sync | demo     suite / regenerate host bundles / 30-second proof"
  echo "  run \`bash \${SIFT_PLUGIN_ROOT:-.}/scripts/demo.sh\` or 'sift demo' to see confirmed->corrupt"
}
case "$cmd" in
  help|--help|-h)  _sift_usage ;;
  demo)        bash "$SIFT_PLUGIN_ROOT/scripts/demo.sh" "$@" ;;
  version)     cat "$SIFT_PLUGIN_ROOT/VERSION" 2>/dev/null || echo "0.0.0-spine" ;;
  plan|execute|review)
               . "$SIFT_PLUGIN_ROOT/kernel/pipeline.sh"; "sift_$cmd" "$@" ;;
  state)       . "$SIFT_PLUGIN_ROOT/kernel/state.sh"; project_state "$@" ;;
  status)      . "$SIFT_PLUGIN_ROOT/kernel/status.sh"; sift_status "$@" ;;
  sync)        . "$SIFT_PLUGIN_ROOT/kernel/sync.sh"; sift_sync "$@" ;;
  verify-log)  . "$SIFT_PLUGIN_ROOT/kernel/log.sh"; verify_log_chain ;;
  migrate-log) case "${1:-}" in --help|-h) echo "usage: sift migrate-log — re-chain a pre-chain (old-schema) log to the current schema (backs up to <log>.pre-migrate)"; exit 0 ;; esac
               . "$SIFT_PLUGIN_ROOT/kernel/log.sh"; migrate_log_chain ;;
  selftest)    . "$SIFT_PLUGIN_ROOT/kernel/selftest.sh"; sift_selftest "$@" ;;
  setup)       . "$SIFT_PLUGIN_ROOT/kernel/setup.sh"; sift_setup "$@" ;;
  wave-review) . "$SIFT_PLUGIN_ROOT/kernel/wave.sh"; sift_wave_review "$@" ;;
  coverage)    . "$SIFT_PLUGIN_ROOT/kernel/wave.sh"; sift_coverage "$@" ;;
  next)        . "$SIFT_PLUGIN_ROOT/kernel/next.sh"; sift_next "$@" ;;
  abort)       . "$SIFT_PLUGIN_ROOT/kernel/state.sh"; sift_abort "$@" ;;
  supersede)   . "$SIFT_PLUGIN_ROOT/kernel/state.sh"; sift_supersede "$@" ;;
  audit)       . "$SIFT_PLUGIN_ROOT/kernel/audit.sh"; sift_audit "$@" ;;
  w3-verdict)  . "$SIFT_PLUGIN_ROOT/kernel/w3_verdict.sh"; sift_w3_verdict "$@" ;;
  doctor)      . "$SIFT_PLUGIN_ROOT/kernel/doctor.sh"; sift_doctor "$@" ;;
  focus)       . "$SIFT_PLUGIN_ROOT/kernel/scope_guard.sh"; sift_focus "$@" ;;
  init-claudemd) . "$SIFT_PLUGIN_ROOT/kernel/scaffold.sh"; sift_init_claudemd "$@" ;;
  packet)      case "${1:-}" in
                 new)      shift; . "$SIFT_PLUGIN_ROOT/kernel/scaffold.sh"; sift_scaffold "$@" ;;
                 validate) shift; . "$SIFT_PLUGIN_ROOT/kernel/scaffold.sh"; sift_packet_validate "$@" ;;
                 *)        echo "[sift] usage: sift packet {new <id> [--profile P]|validate <id>}" >&2; exit 0 ;;
               esac ;;
  "")          echo "[sift] usage: sift {version|plan|execute|review|state|status|verify-log|migrate-log|selftest|setup|wave-review|coverage|next|abort|supersede|audit|w3-verdict|doctor|focus|init-claudemd|packet|sync} ..." >&2; exit 0 ;;
  *)           echo "[sift] unknown subcommand '$cmd' (fail-soft, no-op)" >&2; exit 0 ;;
esac
